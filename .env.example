# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase
# Local values come from `supabase status`. The service-role key bypasses RLS:
# server-only, never in a client component, never in a NEXT_PUBLIC_ variable.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Payments — pick one provider per order, keep both configured in dev.
# Verify current support and contracts before launch (see docs/adr/0001).
# -----------------------------------------------------------------------------
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_WEBHOOK_SECRET=

PAYMEE_API_KEY=
PAYMEE_VENDOR_ID=
PAYMEE_WEBHOOK_SECRET=

# Commission in basis points (1000 = 10 %). Snapshot into order_items at sale.
PLATFORM_COMMISSION_BP=1000

# -----------------------------------------------------------------------------
# Delivery
# -----------------------------------------------------------------------------
FIRST_DELIVERY_API_KEY=
FIRST_DELIVERY_WEBHOOK_SECRET=
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_ACCOUNT_PIN=

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# -----------------------------------------------------------------------------
# Ops
# -----------------------------------------------------------------------------
# Shared secret for the internal cron endpoints (release window, expiry sweep).
CRON_SECRET=
# Optional: Sentry / OpenTelemetry
SENTRY_DSN=
